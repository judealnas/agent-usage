{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Usage",
  "identifier": "com.agent-usage-window.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Usage",
        "width": 340,
        "height": 260,
        "minWidth": 260,
        "minHeight": 40,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
